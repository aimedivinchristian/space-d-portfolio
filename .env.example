# ─── EMAIL CONFIGURATION ───────────────────────────────────────────────────
# Copy this file to .env.local and fill in your credentials
# .env.local is gitignored — never commit real credentials

# For Gmail: go to myaccount.google.com/apppasswords and generate an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Where to receive contact form messages
CONTACT_EMAIL=aimedivinchristian@gmail.com
