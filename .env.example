# Copy this file to .env.local and fill in your credentials
# .env.local is gitignored — never commit real credentials

# ─── DATABASE (Postgres) ───────────────────────────────────────────────────
# Vercel Postgres / Neon / Supabase connection string.
# Neon free tier: https://neon.tech → create project → copy the pooled connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─── NEXTAUTH ──────────────────────────────────────────────────────────────
# Secret used to sign session tokens. Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-long-random-string
# Canonical site URL (http://localhost:3000 in dev; your domain in production)
NEXTAUTH_URL=http://localhost:3000

# ─── INITIAL ADMIN ACCOUNT (used by `npm run db:seed`) ─────────────────────
ADMIN_EMAIL=admin@spaced.dev
ADMIN_PASSWORD=change-this-password

# ─── EMAIL CONFIGURATION ───────────────────────────────────────────────────
# For Gmail: go to myaccount.google.com/apppasswords and generate an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password

# Where to receive contact form messages
CONTACT_EMAIL=aimedivinchristian@gmail.com
